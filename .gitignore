# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
.vscode/

# Claude Code agent-local config
.claude/

# Queue of problems scaffolded but not solved yet — stays on the machine
/lib/scaffold/

# Shortlist pulled out of the scaffold queue, next to be solved — also local only
/lib/pickup/

# Solved on LeetCode, no episode decided yet — moves to lib/leetcode/ only if filmed
/lib/solved/

# LeetCode ships no Dart snippet for these, so they cannot be attempted
/lib/no-dart/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
